<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dicas para acalmar"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:text="Escolha uma e tente agora, sem pressa."
            android:textSize="18sp"
            android:textColor="@color/ink_soft" />

        <LinearLayout style="@style/TipCard">
            <TextView style="@style/TipIcon" android:text="🛁" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/TipTitle" android:text="Banho morno" />
                <TextView style="@style/TipDesc" android:text="Um banho morno, sem pressa, ajuda o corpo a soltar a tensão. Evite água muito quente." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/TipCard">
            <TextView style="@style/TipIcon" android:text="🚶" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/TipTitle" android:text="Caminhada leve" />
                <TextView style="@style/TipDesc" android:text="Caminhe por 15 minutos em ritmo confortável, de preferência ao ar livre." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/TipCard">
            <TextView style="@style/TipIcon" android:text="🧘" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/TipTitle" android:text="Alongamento suave" />
                <TextView style="@style/TipDesc" android:text="Sentado numa cadeira, gire os ombros e incline a cabeça devagar. Não force." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/TipCard">
            <TextView style="@style/TipIcon" android:text="👀" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/TipTitle" android:text="Olhe ao redor: 5-4-3-2-1" />
                <TextView style="@style/TipDesc" android:text="Diga 5 coisas que vê, 4 que pode tocar, 3 que escuta, 2 que cheira e 1 que sente o gosto." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/TipCard">
            <TextView style="@style/TipIcon" android:text="🍵" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/TipTitle" android:text="Uma bebida morna" />
                <TextView style="@style/TipDesc" android:text="Beba água ou um chá sem cafeína, aos poucos. Evite café e refrigerante em excesso." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/TipCard">
            <TextView style="@style/TipIcon" android:text="📞" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/TipTitle" android:text="Fale com alguém" />
                <TextView style="@style/TipDesc" android:text="Ligue ou mande mensagem para alguém de confiança, só para ter companhia." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/TipCard">
            <TextView style="@style/TipIcon" android:text="🏊" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/TipTitle" android:text="Movimento que você gosta" />
                <TextView style="@style/TipDesc" android:text="Hidroginástica, dança ou tai chi, de 2 a 3 vezes por semana, ajudam bastante." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lembrete diário de respiração"
                android:textColor="@color/ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:text="Uma notificação por dia para lembrar você de respirar. Funciona sem internet."
                android:textColor="@color/ink_soft"
                android:textSize="15sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_reminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Ativar lembrete"
                android:textColor="@color/ink"
                android:textSize="17sp" />

            <Button
                android:id="@+id/btn_reminder_time"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Horário: 20:00"
                android:textAllCaps="false" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contatos de confiança"
                android:textColor="@color/ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Pessoas que podem te ajudar rápido. Toque para ligar ou mandar mensagem."
                android:textColor="@color/ink_soft"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/row_contact_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_contact_name_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contato 1: não configurado"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_call_1"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/primary"
                        android:text="📞 Ligar"
                        android:textAllCaps="false"
                        android:textColor="@color/on_primary" />

                    <Button
                        android:id="@+id/btn_sms_1"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="💬 SMS"
                        android:textAllCaps="false"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                </LinearLayout>

            </LinearLayout>
            <LinearLayout
                android:id="@+id/row_contact_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_contact_name_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contato 2: não configurado"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_call_2"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/primary"
                        android:text="📞 Ligar"
                        android:textAllCaps="false"
                        android:textColor="@color/on_primary" />

                    <Button
                        android:id="@+id/btn_sms_2"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="💬 SMS"
                        android:textAllCaps="false"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                </LinearLayout>

            </LinearLayout>
            <LinearLayout
                android:id="@+id/row_contact_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_contact_name_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contato 3: não configurado"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_call_3"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/primary"
                        android:text="📞 Ligar"
                        android:textAllCaps="false"
                        android:textColor="@color/on_primary" />

                    <Button
                        android:id="@+id/btn_sms_3"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="💬 SMS"
                        android:textAllCaps="false"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btn_edit_contacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Editar meus contatos"
                android:textAllCaps="false"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_help_card"
            android:padding="18dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quer conversar com alguém?"
                android:textStyle="bold"
                android:textSize="19sp"
                android:textColor="@color/ink" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:text="Estas dicas ajudam no dia a dia e não substituem acompanhamento médico ou psicológico."
                android:textSize="15sp"
                android:textColor="@color/ink_soft" />

            <Button
                android:id="@+id/btn_cvv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Ligar para o CVV (188)"
                android:textAllCaps="false"
                android:backgroundTint="@color/primary"
                android:textColor="@color/on_primary" />

            <Button
                android:id="@+id/btn_samu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Emergência: SAMU (192)"
                android:textAllCaps="false"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
