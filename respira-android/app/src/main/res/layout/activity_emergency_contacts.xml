<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Contatos de confiança"
                android:textColor="@color/ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_close"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fechar"
                android:textAllCaps="false" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="Cadastre até 3 pessoas de confiança. Pode deixar em branco."
            android:textColor="@color/ink_soft"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Contato 1"
            android:textColor="@color/ink"
            android:textSize="19sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_name_1"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="Nome"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_soft"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/et_phone_1"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="Telefone (com DDD)"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_soft"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Contato 2"
            android:textColor="@color/ink"
            android:textSize="19sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_name_2"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="Nome"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_soft"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/et_phone_2"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="Telefone (com DDD)"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_soft"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Contato 3"
            android:textColor="@color/ink"
            android:textSize="19sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_name_3"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="Nome"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_soft"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/et_phone_3"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="Telefone (com DDD)"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_soft"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primary"
            android:text="Salvar contatos"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ligar abre o discador já com o número. SMS abre o app de mensagens com um texto pronto — você revê e confirma antes de enviar."
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
